
params {
    sample_id = 1
    run_id = 1
    testing = ""
    help=""
    publish_dir = ""
}

profiles {
    local {
        process {
            executor = 'local'
        }
        docker {
            enabled = true
            fixOwnership = true
        }
        env.WORKSPACE = 'offline'
    }

    testing {
        docker {
            enabled = true
            fixOwnership = true
        }
        params.testing = "true"
        process.debug = true
        env.WORKSPACE = 'offline'
    }

    mini {
        process {
            executor = "k8s"
        }
        k8s {
            workDir = "/workspace"
            namespace        = 'default'

            serviceAccount   = 'default'
            computeResourceType = 'Job'
            storageClaimName = 'standard'
            storageMountPath = '/workspace'
      }
    }

    kubernetes {
        process {
            executor = "k8s"
        }
        k8s {
            workDir = "/workspace"
            namespace        = 'default'

            serviceAccount   = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
      }
    }

}
