nextflow_workflow {
    name 'Test clockwork Pipeline'
    script 'main.nf'
    workflow 'clockwork'

    test('Should run without failures') {
        when {
            workflow {
                """
                input[0] = [
                    "sample",
                    "ref_id",
                    "$projectDir/test_data/ref_data",
                    [file("$projectDir/test_data/successful/sample_1.fastq.gz"),
                     file("$projectDir/test_data/successful/sample_2.fastq.gz")]
                ]
                """
            }
        }

        then {
            assert workflow.success

            assert workflow.out.final_fasta[0][2].contains('final.fasta')
            assert workflow.out.variants_vcf[0][2].contains('variants.vcf')
            assert workflow.out.all_calls_vcf[0][2].contains('all_calls.vcf')

            assert path(workflow.out.final_fasta[0][2]).md5 == path("$projectDir/test_data/successful/expected_output.fasta").md5
            assert path(workflow.out.cortex_vcf[0][2]).linesGzip != path("$projectDir/test_data/not_enough_reads/empty.vcf.gz").linesGzip
        }
    }

    test('Should run without failures even if cortex produces no vcf') {
        when {
            workflow {
                """
                input[0] = [
                    "sample",
                    "ref_id",
                    "$projectDir/test_data/ref_data",
                    [file("$projectDir/test_data/not_enough_reads/sample_1.fastq.gz"),
                     file("$projectDir/test_data/not_enough_reads/sample_2.fastq.gz")]
                ]
                """
            }
        }

        then {
            assert workflow.success
            assert path(workflow.out.cortex_vcf[0][2]).linesGzip == path("$projectDir/test_data/not_enough_reads/empty.vcf.gz").linesGzip
        }
    }

    test('Specifying input with no files causes pipeline to fail.') {
        when {
            workflow {
                """
                input[0] = [
                    "sample",
                    "ref_id",
                    "$projectDir/test_data/ref_data",
                    [file("$projectDir/test_data/no_files/sample_1.fastq.gz"),
                     file("$projectDir/test_data/no_files/sample_2.fastq.gz")]
                ]
                """
            }
        }

        then {
            assert workflow.failed // Ideally, this would check for a specific error
        }
    }
}
