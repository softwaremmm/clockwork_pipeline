nextflow_workflow {
    name 'Test clockwork Pipeline'
    script 'main.nf'
    workflow 'clockwork'

    test('Should run without failures') {
        when {
            workflow {
                """
                read_ch = Channel.fromFilePairs("$projectDir/test_data/successful/*_{1,2}.fastq.gz", checkIfExists:true)
                read_ch = read_ch.map { it ->
                    [
                        it[0],
                        it[1],
                        params.reference,
                        params.accession,
                        file("$projectDir/test_data/ref_data/ref.fa.gz"),
                    ]
                }
                input[0] = read_ch
                """
            }
        }

        then {
            assert workflow.success

            assert path(workflow.out.final_fasta[0][1]).md5 == path("$projectDir/test_data/successful/expected_output.fasta").md5
            assert path(workflow.out.cortex_vcf[0][1]).linesGzip != path("$projectDir/test_data/not_enough_reads/empty.vcf.gz").linesGzip
        }
    }

    test('Should run without failures even if cortex produces no vcf') {
        when {
            workflow {
                """
                read_ch = Channel.fromFilePairs("$projectDir/test_data/not_enough_reads/*_{1,2}.fastq.gz", checkIfExists:true)
                read_ch = read_ch.map { it ->
                    [
                        it[0],
                        it[1],
                        params.reference,
                        params.accession,
                        file("$projectDir/test_data/ref_data/ref.fa.gz"),
                    ]
                }
                input[0] = read_ch
                """
            }
        }

        then {
            assert workflow.success
            assert path(workflow.out.cortex_vcf[0][1]).linesGzip == path("$projectDir/test_data/not_enough_reads/empty.vcf.gz").linesGzip
        }
    }

    test('Specifying input with no files causes pipeline to fail.') {
        when {
            workflow {
                """
                input[0] = Channel.fromFilePairs("$projectDir/test_data/no_files/*_{1,2}.fastq.gz", checkIfExists:true)
                input[1] = "$projectDir/test_data/ref_data/ref.fa.gz"
                """
            }
        }

        then {
            assert workflow.failed // Ideally, this would check for a specific error
        }
    }
}
