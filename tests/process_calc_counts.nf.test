nextflow_process {
    name "Test post clockwork calculate counts process"
    script "main.nf"
    process "calc_counts"

    test("Regression test on calcuates outputs") {

        when {
            process {
            """
            input[0] = ["sample", file("$projectDir/test_data/calc_counts_input_files/test.gvcf.gz"), file("$projectDir/test_data/calc_counts_input_files/test.fasta")]
            input[1] = file("$projectDir/tb_clockwork_report.json.template")
            input[2] = "$projectDir/test_data/ref_data"
            """
            }
        }

        then {
            assert process.success

            assert path(process.out.tb_clockwork_report_json[0][1]).json == path('test_data/genome_creation_report.json').json
        }
    }
}